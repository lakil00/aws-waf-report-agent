  {
    "name": "update_web_acl_rules",
    "description": "Update Web ACL rules. Dry-run by default. Real updates are refused unless the Lambda has WAF writes enabled; new or changed rules must be COUNT-only, existing rules cannot be removed, max 5 new rules per call.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "web_acl_arn": {
          "type": "string"
        },
        "rules_json": {
          "type": "string",
          "description": "JSON array of the COMPLETE rule list (existing rules unchanged plus new COUNT rules)"
        },
        "lock_token": {
          "type": "string",
          "description": "Ignored. The server fetches a fresh lock token at apply time."
        },
        "dry_run": {
          "type": "boolean",
          "description": "Default true"
        },
        "region": {
          "type": "string"
        },
        "_tool": {
          "type": "string",
          "description": "Must be \"update_web_acl_rules\"",
          "enum": [
            "update_web_acl_rules"
          ]
        }
      },
      "required": [
        "web_acl_arn",
        "rules_json",
        "_tool"
      ]
    }
  },
