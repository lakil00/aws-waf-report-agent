permit(
  principal == AgentCore::IamEntity::"${principal_id}",
  action in
  [AgentCore::Action::"${target_name}___query_waf_summary",
   AgentCore::Action::"${target_name}___query_top_blocked",
   AgentCore::Action::"${target_name}___run_custom_waf_query",
   AgentCore::Action::"${target_name}___query_false_positive_signals",
   AgentCore::Action::"${target_name}___investigate_ip_deep",
   AgentCore::Action::"${target_name}___current_datetime"],
  resource == AgentCore::Gateway::"${gateway_arn}"
);
