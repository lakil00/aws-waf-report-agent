#!/usr/bin/env bash
# Git pre-commit hook — runs the doc-drift check before allowing a commit.
#
# Install with:
#   scripts/hooks/install.sh
#
# Skip once with:
#   git commit --no-verify
#
# The check is fast (<3 s) and only inspects text — it never contacts AWS.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
CHECK="$REPO_ROOT/scripts/check_doc_drift.sh"

if [ ! -x "$CHECK" ]; then
  echo "pre-commit: $CHECK missing or not executable — skipping drift check" >&2
  exit 0
fi

# Only run the drift check when a file it cares about is staged.
# Otherwise skip silently to keep unrelated commits fast.
STAGED=$(git diff --cached --name-only)
if ! grep -qE '^(README\.(md|ko\.md)|tests/test_tools\.py|infra/(variables\.tf|terraform\.tfvars\.example)|scripts/check_doc_drift\.sh|docs/ANALYSIS_AGENT_REQUIREMENTS(_ko)?\.md)$' <<< "$STAGED"; then
  exit 0
fi

echo "pre-commit: running doc-drift check…"
if ! "$CHECK"; then
  cat >&2 <<'MSG'

pre-commit: doc-drift detected. Options:
  1. Fix the drift (update README / tfvars.example) and re-stage.
  2. Bypass just this once:  git commit --no-verify
MSG
  exit 1
fi
